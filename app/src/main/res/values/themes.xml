<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.BuiltDaily" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_surface_strong</item>
        <item name="colorOnPrimaryContainer">@color/teal_text</item>
        <item name="colorSecondary">@color/teal_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/teal_text</item>
        <item name="android:statusBarColor">@color/teal_primary_dark</item>
        <item name="android:windowBackground">@color/teal_surface</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="materialButtonStyle">@style/Widget.BuiltDaily.Button</item>
    </style>

    <style name="Theme.BuiltDaily" parent="Base.Theme.BuiltDaily" />

    <style name="Widget.BuiltDaily.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/teal_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">18dp</item>
    </style>
</resources>
